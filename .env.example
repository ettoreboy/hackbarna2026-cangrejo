# --- Analyzer selection ---
# nebius (default) | gemini | fake (offline, deterministic, no keys needed)
ANALYZER_PROVIDER=nebius

# --- Nebius Token Factory (primary) ---
# https://tokenfactory.nebius.com/ → API keys
NEBIUS_API_KEY=
# gpt-oss-120b measured 1.4-2.7 s end to end; Qwen3-235B 2.5-4 s; Qwen3-30B-A3B 27 s (unusable).
NEBIUS_MODEL=openai/gpt-oss-120b
# Model for step 1 (claim extraction). Empty = same as NEBIUS_MODEL.
NEBIUS_FAST_MODEL=
# low | medium | high, or empty to omit the parameter. gpt-oss honours it.
NEBIUS_REASONING_EFFORT=low
# 0 = same post gives the same answer. At 0.2 only 72% of verdicts repeated across two
# identical runs over 50 tweets; at 0 it is 86%. See docs/EVAL.md section 3.
NEBIUS_TEMPERATURE=0.0
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TIMEOUT_SECONDS=30
# Optional. USD per 1M tokens as {"model/id": [input, output]}. Seeded table in
# backend/services/pricing.py; an unpriced model just reports cost_usd: null.
# NEBIUS_PRICES={"Qwen/Qwen3-32B": [0.10, 0.30]}

# --- Google AI Studio (baseline) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
# 0 so the same post gives the same answer, matching NEBIUS_TEMPERATURE. A comparison run
# must measure the prompt or the provider, not sampling noise.
GEMINI_TEMPERATURE=0.0
# Optional. USD per 1M tokens as {"model/id": [input, output]}, same shape as NEBIUS_PRICES.
# Seeded table in backend/services/pricing.py.
# GEMINI_PRICES={"gemini-2.5-flash": [0.30, 2.50]}

# --- Evidence and author background ---
# Brave powers BOTH the claim search (step 2) and the author fallback when Wikipedia has no
# page. Without it every claim verdict is "unverifiable". Free tier: 2000 queries/month.
BRAVE_API_KEY=
# Hard stop on live Brave calls, counted in SEARCH_CACHE_PATH. $10 = 2000 requests.
BRAVE_BUDGET=1500
# Use Brave for authors Wikipedia does not know. Off: they become "Unknown author" for free.
BACKGROUND_BRAVE_FALLBACK=false
# Every Brave result is cached here forever; delete the file to start over.
SEARCH_CACHE_PATH=.cache/brave.sqlite
EVIDENCE_RESULT_COUNT=5
SEARCH_RESULT_COUNT=3
WIKIPEDIA_LANG=en

# --- Galtea (evaluation platform, sponsor track) ---
# https://platform.galtea.ai/ -> Settings -> Generate API Key
# Only backend/eval/galtea_sync.py uses these; the server never calls Galtea.
GALTEA_API_KEY=
GALTEA_PRODUCT=ContextGuard Social

# --- Speech-to-text for video posts (SLNG) ---
SLNG_API_KEY=
SLNG_REGION=eu-west
MEDIA_MAX_SECONDS=60

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
CACHE_TTL_SECONDS=86400
# Analysed posts, kept between restarts. The model is not reproducible run to run, so this
# file is what makes a post answer the same way twice. Empty = memory only.
RESPONSE_CACHE_PATH=.cache/responses.sqlite
