# --- Analyzer selection ---
# nebius (default) | gemini | fake (offline, deterministic, no keys needed)
ANALYZER_PROVIDER=nebius

# --- Nebius Token Factory (primary) ---
# https://tokenfactory.nebius.com/ → API keys
NEBIUS_API_KEY=
NEBIUS_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_TIMEOUT_SECONDS=30

# --- Google AI Studio (baseline) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Author background (optional) ---
# Wikipedia is always tried first and needs no key. Brave only when Wikipedia has no page.
BRAVE_API_KEY=
SEARCH_RESULT_COUNT=3
WIKIPEDIA_LANG=en

# --- Speech-to-text for video posts (SLNG) ---
SLNG_API_KEY=
SLNG_REGION=eu-west
MEDIA_MAX_SECONDS=60

# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
CACHE_TTL_SECONDS=86400
