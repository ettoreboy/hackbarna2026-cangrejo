{
  "manifest_version": 3,
  "name": "Unfold",
  "version": "0.2.0",
  "description": "Find the checkable claim in a post on X, check it against the web, and see what context is missing. Not a fact-checker.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage"],

  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],

  "background": {
    "service_worker": "background/background.js",
    "scripts": ["background/background.js"]
  },

  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content/taxonomy.js", "content/theme.js", "content/card.js", "content/content.js"],
      "css": ["styles/button.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Unfold",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "unfold@hackbarna",
      "strict_min_version": "115.0"
    }
  }
}
